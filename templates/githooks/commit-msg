#!/usr/bin/env bash
# Strips AI-attribution trailers before the commit is written, so they never
# land in history regardless of which tool proposed them.
# Installed by tjforge. Enable per clone:  git config core.hooksPath .githooks
set -euo pipefail
FILE="$1"

strip() {
  local pattern="$1"
  if grep -qiE "$pattern" "$FILE"; then
    grep -viE "$pattern" "$FILE" > "$FILE.tmp" || true
    mv "$FILE.tmp" "$FILE"
  fi
}

# Co-Authored-By / Co-authored-by (any casing)
strip "^[[:space:]]*Co-authored-by:"

# Footers Claude Code, Cursor and similar tools append
strip "generated with \[claude code\]"
strip "generated with claude code"
strip "generated with cursor"
strip "generated by cursor"
strip "^Made-with:[[:space:]]*Cursor"

# Drop blank lines the removal left at the end of the message
awk '{ l[NR] = $0 }
     END { n = NR
           while (n > 0 && l[n] ~ /^[[:space:]]*$/) n--
           for (i = 1; i <= n; i++) print l[i] }' "$FILE" > "$FILE.tmp"
mv "$FILE.tmp" "$FILE"
